{
  "manifest_version": 3,
  "name": "GAPS Beautifuler",
  "version": "7.7.0",
  "description": "Refonte moderne et non officielle de GAPS (HEIG-VD) : thème clair et sombre, toutes les pages. CSS uniquement.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gaps.heig-vd.ch/*",
        "http://gaps.heig-vd.ch/*",
        "https://mse.hes-so.ch/*",
        "http://mse.hes-so.ch/*"
      ],
      "css": [
        "gaps.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "105"
}
